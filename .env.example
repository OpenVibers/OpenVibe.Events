# ═══════════════════════════════════════════════════════════════
# OpenVibe.Events — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/events.env (0600); the systemd unit sets
# NODE_ENV, PORT and EVENTS_DB_PATH itself.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4300
HOST=127.0.0.1
NODE_ENV=development
#BASE_URL=https://events.openvibe.network

# Identity — OpenVibe.Network signs service tokens (client_credentials, audience
# openvibe.events) and user JWTs. The public key is fetched from
# <url>/api/.well-known/jwks (internal URL first), retried every 30 s until it loads.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# Expected `iss` of every token (defaults to OV_NETWORK_URL).
#OV_NETWORK_ISSUER=https://openvibe.network
# Pin the key instead of fetching it (PEM; \n escapes allowed).
#OV_NETWORK_PUBLIC_KEY=
# A browser's user JWT is accepted when its aud contains one of these.
#EVENTS_USER_AUDIENCES=openvibe.events,openvibe.network

# Store (SQLite). Production: /var/lib/openvibe-events/events.db (systemd StateDirectory).
EVENTS_DB_PATH=./data/events.db
# Events (and their deliveries) older than this are pruned; resuming from before it yields a gap.
EVENTS_RETENTION_DAYS=30
# Accepted event ids are remembered this long, so late re-publishes stay duplicates.
EVENTS_RECEIPT_RETENTION_DAYS=90
#EVENTS_PRUNE_INTERVAL_MS=3600000

# Publishing
#EVENTS_MAX_PAYLOAD_BYTES=65536
# A trace may carry this many hops before a publish is refused (events.loop_detected).
#EVENTS_MAX_HOPS=8
# Which source may publish which event_type prefixes. JSON; replaces the default, which is
# { "<source>": ["<source>."] } for live media network community chat openre billing tips vip
# ai games tools codes host sources search wiki blog news reviews deals coupons trade. Every prefix
# must start with "<source>."; "app" and "app-*" are reserved for developer apps.
#EVENTS_SOURCE_PREFIXES={"live":["live."],"media":["media."]}

# Delivery worker
#EVENTS_WORKER=on
#EVENTS_WORKER_INTERVAL_MS=500
#EVENTS_MAX_INFLIGHT=20
# Of which developer-app deliveries may use at most (default: half of EVENTS_MAX_INFLIGHT)
#EVENTS_APP_MAX_INFLIGHT=10
#EVENTS_DELIVERY_TIMEOUT_MS=10000
#EVENTS_MAX_ATTEMPTS=8
#EVENTS_BACKOFF_MS=1000,5000,30000,120000,600000,3600000
# /api/ready lists `dlq` as degraded (the service stays ready) above this many dead deliveries.
#EVENTS_DLQ_DEGRADED_AT=100
#EVENTS_MAX_SUBSCRIPTIONS=100
# Hostnames a subscription endpoint may use (SSRF guard). `*.openvibe.*` = openvibe.<tld>
# and its subdomains; IP literals only when listed exactly.
#EVENTS_ENDPOINT_HOSTS=127.0.0.1,*.openvibe.*

# Developer apps (events.app.publish|read|subscribe, ADR-014). App subscriptions must use public
# https endpoints (no allow-list; checked at subscribe and delivery time). Quotas are per project
# and environment; 0 turns a limit off. EVENTS_APPS=off disables the app paths.
#EVENTS_APPS=on
#EVENTS_APP_PUBLISH_PER_MINUTE=120
#EVENTS_APP_RETAINED_BYTES=52428800
#EVENTS_APP_MAX_SUBSCRIPTIONS=20
#EVENTS_APP_SANDBOX_PUBLISH_PER_MINUTE=30
#EVENTS_APP_SANDBOX_RETAINED_BYTES=5242880
#EVENTS_APP_SANDBOX_MAX_SUBSCRIPTIONS=5
#EVENTS_APP_SANDBOX_RETENTION_DAYS=7

# Realtime (SSE) gateway
#REALTIME_MAX_CONNECTIONS=2000
#REALTIME_MAX_TOPICS=20
#REALTIME_HEARTBEAT_MS=25000
#REALTIME_REPLAY_MAX=1000
# A browser resuming with Last-Event-ID is replayed public events received this recently only
# (0: none); older public events come as `event: gap` (reason public_window). Subject events
# addressed to the viewer, and service viewers, keep the whole retention.
#REALTIME_PUBLIC_REPLAY_SECONDS=300
# Signed-out browsers may receive public events.
#REALTIME_ALLOW_ANONYMOUS=true
# Exact extra CORS origins besides https://*.openvibe.* (development).
#REALTIME_CORS_ORIGINS=http://localhost:3000
