{
  "name": "openvibe-events",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.Events: durable events, subscriptions, signed delivery with retry, dead letters and replay, plus the browser realtime (SSE) gateway. lib/client.js is the producer/consumer helper other services depend on.",
  "main": "lib/client.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "test": "node test/run.js",
    "test:pg": "EVENTS_TEST_STORE=pg node test/run.js"
  },
  "keywords": [
    "openvibe",
    "events",
    "outbox",
    "webhooks",
    "sse"
  ],
  "author": "OpenVibers",
  "license": "AGPL-3.0-only",
  "repository": "github:OpenVibers/OpenVibe.Events",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "iovalkey": "^0.4.0",
    "openvibe-contracts": "https://codeload.github.com/OpenVibers/OpenVibe.Contracts/tar.gz/refs/tags/v0.81.0",
    "openvibe-sdk": "https://codeload.github.com/OpenVibers/OpenVibe.SDK/tar.gz/refs/tags/v0.26.0",
    "openvibe-shared": "https://codeload.github.com/OpenVibers/OpenVibe.Shared/tar.gz/refs/tags/v2.2.0",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
